# Wallbot Configuration
# Copy this file to .env and adjust as needed

# Environment: development or production
WALLBOT_ENV=development

# HTTP Server
WALLBOT_HOST=0.0.0.0
WALLBOT_PORT=9500

# Data directory (database, cache, renders)
WALLBOT_DATA_DIR=./data

# Logging level: DEBUG, INFO, WARNING, ERROR
WALLBOT_LOG_LEVEL=DEBUG

# Watcher interval in seconds (how often to check Wallapop)
WALLBOT_SEARCH_INTERVAL=60

# Wallapop API timeout in seconds
WALLBOT_WALLAPOP_TIMEOUT=30

# ESP32 screen rotation interval in seconds (how long each search is displayed)
WALLBOT_ROTATION_INTERVAL=10
